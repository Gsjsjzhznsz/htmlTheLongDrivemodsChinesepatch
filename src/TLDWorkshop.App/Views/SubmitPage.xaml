<Page x:Class="TLDWorkshop.App.Views.SubmitPage"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
               xmlns:ctrl="clr-namespace:TLDWorkshop.App.Controls"
               Title="{DynamicResource Nav.Submit}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" CanContentScroll="False" ctrl:ScrollViewerHelper.EnableWheelScroll="True"
                 >
        <StackPanel Margin="32" MaxWidth="700">
            <TextBlock Text="{DynamicResource Submit.Header}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Opacity="0.7" Margin="0,0,0,24"
                       Text="{DynamicResource Submit.Desc}" />

            <ui:TextBox PlaceholderText="{DynamicResource Submit.ModName}" Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12" />
            <ui:TextBox PlaceholderText="{DynamicResource Submit.Author}"
                        Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12" />
            <ui:TextBox PlaceholderText="{DynamicResource Submit.Version}"
                        Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12" />
            <ui:TextBox PlaceholderText="{DynamicResource Submit.Description}"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,12"
                        MinLines="3" AcceptsReturn="True" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="True" Width="500" />
                <ui:Button Content="{DynamicResource Common.Browse}" Icon="FolderOpen24"
                           Command="{Binding BrowseFileCommand}" Margin="8,0,0,0" />
            </StackPanel>

            <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,0,0,12" />

            <ui:Button Content="{DynamicResource Submit.Submit}" Icon="Send24" Appearance="Primary"
                       Command="{Binding SubmitCommand}" />

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
