<Page x:Class="TLDWorkshop.App.Views.TldLoaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctrl="clr-namespace:TLDWorkshop.App.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="900"
      Title="{DynamicResource TldLoader.Title}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" CanContentScroll="False" ctrl:ScrollViewerHelper.EnableWheelScroll="True"
                 >
        <StackPanel Margin="24" MaxWidth="900">

            <TextBlock Text="{DynamicResource TldLoader.Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource TldLoader.Subtitle}"
                       Opacity="0.7" Margin="0,0,0,24" />

            <!-- 游戏路径卡片 -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource TldLoader.GamePath}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ui:TextBox Text="{Binding TldPath}" IsReadOnly="True" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource Common.AutoDetect}" Icon="Search24"
                                   Command="{Binding AutoDetectPathCommand}"
                                   Appearance="Secondary" Margin="0,0,8,0" />
                        <ui:Button Content="{DynamicResource Common.Browse}" Icon="FolderOpen24"
                                   Command="{Binding BrowsePathCommand}"
                                   Appearance="Secondary" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 状态卡片 -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource TldLoader.Status}" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding StateText}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{Binding StateColor}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource TldLoader.LoaderVersion}" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding LoaderVersion}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource TldLoader.GameVersion}" Opacity="0.7" FontSize="12" />
                        <TextBlock Text="{Binding GameVersion}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="{DynamicResource TldLoader.InstallUpdate}" Icon="ArrowDownload24" Appearance="Primary"
                           Command="{Binding InstallOrUpdateCommand}"
                           IsEnabled="{Binding CanInstall}"
                           Margin="0,0,8,0" MinWidth="120" />
                <ui:Button Content="{DynamicResource TldLoader.Uninstall}" Icon="Delete24" Appearance="Caution"
                           Command="{Binding UninstallCommand}"
                           IsEnabled="{Binding CanUninstall}"
                           Margin="0,0,8,0" MinWidth="120" />
                <ui:Button Content="{DynamicResource TldLoader.LaunchGame}" Icon="Play24"
                           Command="{Binding LaunchGameCommand}"
                           IsEnabled="{Binding CanLaunch}"
                           Margin="0,0,8,0" MinWidth="120" />
                <ui:Button Content="{DynamicResource TldLoader.OpenMods}" Icon="FolderOpen24"
                           Command="{Binding OpenModsFolderCommand}"
                           Margin="0,0,8,0" MinWidth="120" />
                <ui:Button Content="{DynamicResource TldLoader.RefreshStatus}" Icon="ArrowSync24"
                           Command="{Binding RefreshStatusCommand}"
                           Appearance="Secondary" MinWidth="100" />
            </StackPanel>

            <!-- 下载资源按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:Button Content="{DynamicResource TldLoader.DownloadAll}" Icon="CloudDownload24"
                           Command="{Binding DownloadAllResourcesCommand}"
                           Appearance="Primary"
                           Margin="0,0,8,0" MinWidth="140"
                           ToolTip="{DynamicResource TldLoader.DownloadAllTip}" />
                <ui:Button Content="{DynamicResource TldLoader.DownloadChinese}" Icon="Translate24"
                           Command="{Binding DownloadChineseLoaderCommand}"
                           Appearance="Secondary"
                           MinWidth="160"
                           ToolTip="{DynamicResource TldLoader.DownloadChineseTip}" />
            </StackPanel>

            <!-- 状态消息 -->
            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" Margin="0,0,0,12"
                       Visibility="{Binding IsBusy, Converter={StaticResource Bool2Vis}}" />

            <!-- 操作日志 -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    MinHeight="200" MaxHeight="400">
                <StackPanel>
                    <TextBlock Text="{DynamicResource TldLoader.OperationLog}" FontSize="14" FontWeight="SemiBold"
                               Opacity="0.8" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding LogEntries}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="320"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas"
                                           FontSize="12" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 加载指示器 -->
            <ui:ProgressRing IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource Bool2Vis}}"
                             Width="40" Height="40"
                             HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
