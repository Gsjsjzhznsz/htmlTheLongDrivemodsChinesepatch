<Application x:Class="TLDWorkshop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:TLDWorkshop.App.Converters"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- i18n 字符串资源（默认中文，运行时切换） -->
                <ResourceDictionary Source="Resources/Strings.zh.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:UrlToImageConverter x:Key="UrlToImageConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
