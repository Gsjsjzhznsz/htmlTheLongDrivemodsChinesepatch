<Page x:Class="TLDWorkshop.App.Views.BrowsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:TLDWorkshop.Core.Models;assembly=TLDWorkshop.Core"
      xmlns:ctrl="clr-namespace:TLDWorkshop.App.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{DynamicResource Nav.Browse}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 工具栏 -->
            <RowDefinition Height="Auto" />   <!-- 详情面板 -->
            <RowDefinition Height="*" />      <!-- 卡片网格 -->
            <RowDefinition Height="Auto" />   <!-- 分页 -->
        </Grid.RowDefinitions>

        <!-- 搜索 + 分类 + 刷新 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="{DynamicResource Common.Refresh}" Icon="ArrowSync24"
                       Command="{Binding RefreshCommand}" Appearance="Secondary" Margin="0,0,12,0" />
            <ui:TextBox Grid.Column="1" PlaceholderText="{DynamicResource Browse.SearchPlaceholder}" Icon="Search24"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding CategoryFilter}" MinWidth="100" Margin="0,0,12,0" />
            <ui:Button Grid.Column="3" Content="{DynamicResource Browse.SwitchMyMods}" Icon="Apps24"
                       Command="{Binding GoMyModsCommand}" Appearance="Primary" />
        </Grid>

        <!-- 详情面板：显示两个源 -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                Padding="24" Margin="0,0,0,12"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource Bool2Vis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" PanningMode="VerticalOnly"
                          CanContentScroll="False" ctrl:ScrollViewerHelper.EnableWheelScroll="True">
                <StackPanel HorizontalAlignment="Center" MaxWidth="700">
                    <TextBlock Text="{Binding SelectedMod.FileName}" FontSize="14" Opacity="0.5"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <!-- 两个源并排 -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <!-- 官方源 -->
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Source.Official}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <Border Width="160" Height="160" CornerRadius="8" HorizontalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,8">
                                <ctrl:AsyncImage Url="{Binding SelectedMod.Official.PictureLink}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding SelectedMod.Official.Name}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedMod.Official.Version}" Opacity="0.6" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedMod.Official.Description}" TextWrapping="Wrap"
                                       Opacity="0.8" FontSize="12" MaxHeight="100" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" />
                        </StackPanel>
                        <!-- 中文源 -->
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Source.Chinese}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <Border Width="160" Height="160" CornerRadius="8" HorizontalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,8">
                                <ctrl:AsyncImage Url="{Binding SelectedMod.Jihu.PictureLink}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding SelectedMod.Jihu.Name}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedMod.Jihu.Version}" Opacity="0.6" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedMod.Jihu.Description}" TextWrapping="Wrap"
                                       Opacity="0.8" FontSize="12" MaxHeight="100" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ui:Button Content="{DynamicResource Common.DownloadUpdate}" Appearance="Primary" Icon="ArrowDownload24"
                                   Command="{Binding DownloadSelectedCommand}" Margin="0,0,8,0" MinWidth="120" />
                        <ui:Button Content="{DynamicResource Common.Back}" Icon="ArrowLeft24" Command="{Binding BackToListCommand}"
                                   Appearance="Secondary" MinWidth="80" />
                    </StackPanel>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Margin="0,12,0,0"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource Bool2Vis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 卡片网格：用 UniformGrid 直接放在 Grid Row 2，不用 ScrollViewer/ListBox
             Bug A/2 彻底修复：旧版就是这样设计的，靠分页切换内容，不滚动，所以触屏/滚轮问题都不存在 -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding FilteredMods}"
                      Visibility="{Binding IsListVisible, Converter={StaticResource Bool2Vis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:MergedMod}">
                    <Border Margin="6" Padding="10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Cursor="Hand"
                            MouseLeftButtonDown="Card_Click">
                        <StackPanel>
                            <Border Width="150" Height="150" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                <ctrl:AsyncImage Url="{Binding DisplayPicture}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DisplayAuthor}" Opacity="0.6" FontSize="11"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <ui:Button Content="{DynamicResource Common.Install}" Icon="ArrowDownload24" Appearance="Primary"
                                       HorizontalAlignment="Center" MinWidth="70" Margin="0,2,0,0"
                                       Click="InstallButton_Click" Tag="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 分页 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding IsListVisible, Converter={StaticResource Bool2Vis}}">
            <ui:Button Content="{DynamicResource Browse.PreviousPage}" Icon="ChevronLeft24" Command="{Binding PreviousPageCommand}"
                       Appearance="Secondary" Margin="0,0,12,0" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{DynamicResource Browse.Page}" />
                <TextBlock Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold" Margin="2,0,2,0" />
                <TextBlock Text=" / " />
                <TextBlock Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold" Margin="2,0,2,0" />
                <TextBlock Text="{DynamicResource Browse.PageOf}" />
                <TextBlock Text="{Binding TotalMods, Mode=OneWay}" FontWeight="SemiBold" Margin="2,0,2,0" />
                <TextBlock Text="{DynamicResource Browse.ModsEnd}" />
            </StackPanel>
            <ui:Button Content="{DynamicResource Browse.NextPage}" Icon="ChevronRight24" Command="{Binding NextPageCommand}"
                       Appearance="Secondary" />
        </StackPanel>

        <ui:ProgressRing Grid.Row="0" Grid.RowSpan="4" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource Bool2Vis}}"
                         Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
