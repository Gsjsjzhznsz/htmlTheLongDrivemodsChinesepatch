<Page x:Class="TLDWorkshop.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctrl="clr-namespace:TLDWorkshop.App.Controls"
      Title="{DynamicResource Nav.Home}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly" CanContentScroll="False" ctrl:ScrollViewerHelper.EnableWheelScroll="True"
                 >
        <StackPanel Margin="40" MaxWidth="800" HorizontalAlignment="Center">

            <!-- 大标题 + 副标题居中 -->
            <TextBlock Text="{DynamicResource Home.Title}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="The Long Drive Workshop" FontSize="16" Opacity="0.6"
                       HorizontalAlignment="Center" Margin="0,0,0,32" />

            <!-- 主要操作按钮 2x2 网格 -->
            <UniformGrid Columns="2" Margin="0,0,0,32">
                <ui:Button Content="{DynamicResource Home.BrowseMods}" Icon="Library24" Appearance="Primary"
                           FontSize="18" Padding="24,20" Margin="0,0,8,8"
                           Command="{Binding GoBrowseCommand}" />
                <ui:Button Content="{DynamicResource Home.InstallLoader}" Icon="Wrench24" Appearance="Primary"
                           FontSize="18" Padding="24,20" Margin="8,0,0,8"
                           Command="{Binding GoTldLoaderCommand}" />
                <ui:Button Content="{DynamicResource Home.MyMods}" Icon="AppFolder24"
                           FontSize="18" Padding="24,20" Margin="0,8,8,0"
                           Command="{Binding GoMyModsCommand}" />
                <ui:Button Content="{DynamicResource Home.Settings}" Icon="Settings24"
                           FontSize="18" Padding="24,20" Margin="8,8,0,0"
                           Command="{Binding GoSettingsCommand}" />
            </UniformGrid>

            <!-- 游戏路径卡片 -->
            <ui:CardExpander Header="{DynamicResource Home.GamePath}" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBox Text="{Binding TldPath}" IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="{DynamicResource Common.AutoDetect}" Icon="Search24"
                                   Command="{Binding AutoDetectCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="{DynamicResource Home.GoSettings}" Appearance="Secondary"
                                   Command="{Binding GoSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!-- TLDLoader 状态卡片 -->
            <ui:CardExpander Header="{DynamicResource Home.LoaderStatus}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Home.Status}" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding LoaderStatus}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Home.LoaderVersion}" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding LoaderVersion}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Home.GameVersion}" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{Binding GameVersion}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <ui:Button Content="{DynamicResource Home.GoTldLoader}" Icon="Wrench24" Appearance="Primary"
                               Command="{Binding GoTldLoaderCommand}" />
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" Margin="0,8,0,0" FontSize="12"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
