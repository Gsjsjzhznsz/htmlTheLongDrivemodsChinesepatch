<Page x:Class="TLDWorkshop.App.Views.MyModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:TLDWorkshop.Core.Models;assembly=TLDWorkshop.Core"
      xmlns:ctrl="clr-namespace:TLDWorkshop.App.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{DynamicResource Nav.MyMods}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="{DynamicResource Common.Refresh}" Icon="ArrowSync24" Command="{Binding RefreshCommand}"
                       Margin="0,0,8,0" Appearance="Secondary" />
            <ui:Button Content="{DynamicResource MyMods.OpenFolder}" Icon="FolderOpen24"
                       Command="{Binding OpenModsFolderCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{DynamicResource MyMods.EnableAll}" Icon="Check24" Appearance="Secondary"
                       Command="{Binding EnableAllCommand}" Margin="0,0,8,0" />
            <ui:Button Content="{DynamicResource MyMods.DisableAll}" Icon="Dismiss24" Appearance="Caution"
                       Command="{Binding DisableAllCommand}" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"
                      MinWidth="100" Margin="0,0,8,0" />
            <ui:TextBox PlaceholderText="{DynamicResource MyMods.SearchPlaceholder}" Icon="Search24"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" />
        </StackPanel>

        <!-- 详情面板：显示两个源 -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                Padding="24" Margin="0,0,0,12"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource Bool2Vis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" PanningMode="VerticalOnly"
                          CanContentScroll="False" ctrl:ScrollViewerHelper.EnableWheelScroll="True">
                <StackPanel HorizontalAlignment="Center" MaxWidth="700">
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <!-- 官方源 -->
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Source.Official}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border Width="160" Height="160" CornerRadius="8" HorizontalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,8">
                                <ctrl:AsyncImage Url="{Binding SelectedMod.Official.PictureLink}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding SelectedMod.Official.Name}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedMod.Official.Description}" TextWrapping="Wrap"
                                       Opacity="0.8" FontSize="12" MaxHeight="80" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" />
                        </StackPanel>
                        <!-- 中文源 -->
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource Source.Chinese}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border Width="160" Height="160" CornerRadius="8" HorizontalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,0,8">
                                <ctrl:AsyncImage Url="{Binding SelectedMod.Jihu.PictureLink}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding SelectedMod.Jihu.Name}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedMod.Jihu.Description}" TextWrapping="Wrap"
                                       Opacity="0.8" FontSize="12" MaxHeight="80" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button Content="{DynamicResource Common.Uninstall}" Appearance="Caution" Icon="Delete24"
                                   Command="{Binding UninstallModCommand}" Margin="0,0,8,0" MinWidth="80" />
                        <ui:Button Content="{DynamicResource Common.Reinstall}" Icon="ArrowSync24" Command="{Binding ReinstallModCommand}"
                                   Appearance="Secondary" Margin="0,0,8,0" MinWidth="80" />
                        <ui:Button Content="{DynamicResource Common.Back}" Icon="ArrowLeft24" Command="{Binding BackToListCommand}"
                                   Appearance="Secondary" MinWidth="80" />
                    </StackPanel>
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Margin="0,12,0,0"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource Bool2Vis}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 卡片网格：UniformGrid + 分页，不用 ScrollViewer -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding InstalledMods}"
                      Visibility="{Binding IsListVisible, Converter={StaticResource Bool2Vis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:MergedMod}">
                    <Border Margin="6" Padding="10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Cursor="Hand"
                            MouseLeftButtonDown="Card_Click">
                        <StackPanel>
                            <Border Width="150" Height="150" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                <ctrl:AsyncImage Url="{Binding DisplayPicture}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DisplayAuthor}" Opacity="0.6" FontSize="11"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <ui:Button Content="{DynamicResource Common.Uninstall}" Appearance="Caution" Icon="Delete24"
                                       HorizontalAlignment="Center" MinWidth="70" Margin="0,2,0,0"
                                       Click="UninstallButton_Click" Tag="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 分页（用 MyModsViewModel 现有的，如果没有就隐藏） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding IsListVisible, Converter={StaticResource Bool2Vis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.7">
                <TextBlock Text="{DynamicResource MyMods.TotalPrefix}" />
                <TextBlock Text="{Binding InstalledMods.Count, Mode=OneWay}" FontWeight="SemiBold" Margin="2,0,2,0" />
                <TextBlock Text="{DynamicResource MyMods.TotalSuffix}" />
            </StackPanel>
        </StackPanel>

        <ui:ProgressRing Grid.Row="0" Grid.RowSpan="4" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource Bool2Vis}}"
                         Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
