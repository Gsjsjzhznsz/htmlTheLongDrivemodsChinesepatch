<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TLDWorkshop.Core</RootNamespace>
    <AssemblyName>TLDWorkshop.Core</AssemblyName>
    <Version>9.0.0</Version>
    <Company>KolbenLP / XLDev</Company>
    <Description>The Long Drive Workshop - Core business logic (WPF-UI port)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mono.Cecil 用于程序集注入（TLDLoader） -->
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <!-- JSON 解析 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
